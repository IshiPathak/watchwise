
{
  "manifest_version": 3,
  "name": "WatchWise",
  "version": "0.1.0",
  "description": "Automatically organize your YouTube Watch Later videos into dynamic topic filters.",
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "css": ["watchwise.css"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
